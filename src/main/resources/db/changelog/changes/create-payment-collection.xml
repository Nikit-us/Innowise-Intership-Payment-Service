<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:mongodb="http://www.liquibase.org/xml/ns/mongodb"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
         http://www.liquibase.org/xml/ns/mongodb
         http://www.liquibase.org/xml/ns/mongodb/liquibase-mongodb-latest.xsd">

    <changeSet id="create-collection-schema" author="Nikita">
        <mongodb:createCollection collectionName="payments">
            <mongodb:options>
                {
                validator: {
                    $jsonSchema: {
                        bsonType: "object",
                        required: ["order_id", "user_id", "status", "timestamp", "payment_amount"],
                        properties: {
                            id: {
                                bsonType: "string",
                                description: "Unique payment identifier"
                            },
                            order_id: {
                                bsonType: "string",
                                description: "Associated order identifier"
                            },
                            user_id: {
                                bsonType: "string",
                                description: "User identifier who made the payment"
                            },
                            status: {
                                bsonType: "string",
                                enum: ["pending", "completed", "failed", "refunded", "cancelled"],
                                description: "Payment status"
                            },
                            timestamp: {
                                bsonType: "date",
                                description: "Payment timestamp"
                            },
                            payment_amount: {
                                bsonType: "double",
                                minimum: 0,
                                description: "Payment amount (must be non-negative)"
                                }
                            }
                        }
                    },
                validationAction: "error",
                validationLevel: "strict"
                }
            </mongodb:options>
        </mongodb:createCollection>
    </changeSet>
    <changeSet id="create-index-on-id" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { id: 1 }
            </mongodb:keys>
            <mongodb:options>
                { unique: true, name: "idx_payment_id" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="create-index-on-order_id" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { order_id: 1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "idx_order_id" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="create-index-on-user_id" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { user_id: 1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "idx_user_id" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="create-index-on-status-time" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { status: 1, timestamp: -1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "idx_status_timestamp" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="create-index-on-user_id-timestamp" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { user_id: 1, timestamp: -1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "idx_user_timestamp" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>

    <changeSet id="create-index-on-timestamp" author="Nikita">
        <mongodb:createIndex collectionName="payments">
            <mongodb:keys>
                { timestamp: -1 }
            </mongodb:keys>
            <mongodb:options>
                { name: "idx_timestamp" }
            </mongodb:options>
        </mongodb:createIndex>
    </changeSet>
</databaseChangeLog>